# NexAgentLab SalesOS Configuration
# Copy this file to .env and fill in values as needed.
# Never commit .env to version control.

# --- Data Storage ---
# SALESOS_DATA_DIR=data

# --- Gemini AI (future milestones) ---
# Option 1: API key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-api-key-here
#
# Option 2: Uses Antigravity OAuth automatically (no key needed)

# --- Email Integration (future milestones) ---
# GMAIL_CREDENTIALS_FILE=credentials.json
# GMAIL_SENDER=nexagentlab.tech@gmail.com
# GMAIL_DAILY_LIMIT=20
# GMAIL_DRY_RUN=true

# --- Campaign Defaults (future milestones) ---
# CAMPAIGN_MAX_DAILY_SENDS=20
# CAMPAIGN_FOLLOW_UP_DAYS=3,7,14
# CAMPAIGN_KILL_SWITCH=false
