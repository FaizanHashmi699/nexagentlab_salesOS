# NexAgentLab SalesOS Configuration
# Copy this file to .env and fill in values as needed.
# Never commit .env to version control.

# --- Data Storage ---
# SALESOS_DATA_DIR=data

# --- Free-Tier AI Providers (Optional - deterministic template fallback active) ---
# GroqCloud (Recommended free-tier speed & limits): https://console.groq.com/keys
# GROQ_API_KEY=gsk_your-groq-key-here
#
# Google Gemini (Free tier): https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-key-here
#
# OpenRouter (Free community models): https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# --- Gmail OAuth 2.0 Integration ---
# Path to Desktop client OAuth credentials downloaded from Google Cloud Console
# GMAIL_CREDENTIALS_FILE=credentials.json
#
# Path to stored authorized tokens
# GMAIL_TOKEN_FILE=data/token.json
#
# Official agency sender account (strict identity verification required)
# GMAIL_SENDER=nexagentlab.tech@gmail.com
#
# Daily send limit (conservative protection)
# GMAIL_DAILY_LIMIT=20
#
# Dry-run dispatch mode (Default: true for safety - simulates sends without calling Gmail API)
# GMAIL_DRY_RUN=true

# --- Safety Controls & Compliance ---
# Maximum daily volume cap across campaigns
# CAMPAIGN_MAX_DAILY_SENDS=20
#
# Emergency kill switch: set to 'true' to instantly halt all sending operations
# CAMPAIGN_KILL_SWITCH=false

# --- Follow-Up Automation Configuration ---
# Business-day interval before first follow-up (skips weekends)
# FOLLOWUP_STEP1_DAYS=3
# Business-day interval before second follow-up (skips weekends)
# FOLLOWUP_STEP2_DAYS=5
# Maximum number of automated follow-up steps per lead
# FOLLOWUP_MAX_STEPS=2
